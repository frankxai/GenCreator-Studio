# GenCreator Studio — environment variables.
# Copy to .env.local and fill in.

# === Optional: hosted automation ===
# Default CIS authoring happens in Claude Code, Claude Projects, ChatGPT,
# Cursor, or another creator-owned agent workspace. No server LLM key needed.
# Set these only if the deployed app should run model calls itself.
ANTHROPIC_API_KEY=

# Adds caching, observability, and multi-provider fallback for hosted automation.
# Also works with vercel-labs/ai-cli.
# Get at https://vercel.com/dashboard/ai/gateway
AI_GATEWAY_TOKEN=

# === Voice profile (optional) ===
# Path to a custom voice profile JSON. Defaults to @cis/voice DEFAULT_VOICE.
CIS_VOICE_PROFILE=

# === Palace location (optional) ===
# Where Captures, Briefs, AssetBundles, Publications, Attestations are stored.
# Defaults to ./.palace/ (gitignored).
CIS_PALACE_DIR=./.palace

# === Distribution: Bluesky (free, no API key, no rate limit) ===
# https://bsky.app/settings/app-passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# === Distribution: LinkedIn ===
# https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# === Distribution: Beehiiv (newsletter) ===
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# === Distribution: Farcaster ===
NEYNAR_API_KEY=
FARCASTER_FID=

# === Voice capture (optional — Whisper-on-Groq) ===
# https://console.groq.com
GROQ_API_KEY=
